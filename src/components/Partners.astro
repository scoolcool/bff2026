---
import "../styles/partners.css";
import { translations, type Language } from "../data/translations";
import { partners } from "../data/partners";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].partners;
---

<section id="partners" class="section partners">
  <div class="partners-grid-bg"></div>

  <div class="container partners-inner">

    <div class="partners-heading">

      <div>
        <div class="section-label">
          {t.label}
        </div>

        <h2 class="section-title">
          {t.title}
          <span>{t.titleAccent}</span>
        </h2>
      </div>

      <p class="partners-intro">
        {t.intro}
      </p>

    </div>

    <div class="partners-content">

      <div class="partners-list-heading">
        {t.listTitle}
      </div>

      <div class="partners-list">
        {
          partners.map((partner) => (
            <article class="partner-card">

              <img
                src={partner.logo}
                alt={partner.name[lang]}
                loading="lazy"
              />

              <span>
                {partner.name[lang]}
              </span>

            </article>
          ))
        }

      
      </div>

    </div>

    <a
      class="become-partner"
      href="mailto:olena.agapova@kndise.gov.ua?subject=Партнерство%20BFF-2026"
    >
      <div class="become-partner-icon">
        +
      </div>

      <div>
        <h3>
          {t.becomePartner}
        </h3>

        <p>
          {t.partnerText}
        </p>
      </div>
    </a>

  </div>
</section>