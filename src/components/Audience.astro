---
import "../styles/audience.css";
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].audience;
---

<section
  id="audience"
  class="section audience"
>
  <div class="audience-grid"></div>

  <div class="container audience-inner">

    <div class="audience-heading">

  <div class="audience-title-block">
    <div class="section-label">
      {t.label}
    </div>

    <h2 class="section-title">
      {t.title}
      <span>{t.titleAccent}</span>
    </h2>
  </div>

  <p class="audience-intro">
    {t.intro}
  </p>

</div>

    <div class="audience-list">
      {
        t.items.map((item) => (
          <article class="audience-card">
            <div class="audience-card-top">
              <span class="audience-number">
                {item.number}
              </span>

              <span class="audience-dot"></span>
            </div>

            <h3>
              {item.title}
            </h3>

            <p>
              {item.text}
            </p>
          </article>
        ))
      }
    </div>

  </div>
</section>