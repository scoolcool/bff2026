---
import "../styles/contacts.css";
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].contacts;
---

<section id="contacts" class="section contacts">
  <div class="contacts-grid-bg"></div>

  <div class="container contacts-inner">

    <div class="contacts-heading">
      <div>
        <div class="section-label">
          {t.label}
        </div>

        <h2 class="section-title">
          {t.title}
          <span>{t.titleAccent}</span>
        </h2>
      </div>

      <p class="contacts-intro">
        {t.intro}
      </p>
    </div>

    <div class="contacts-layout">

      <div class="contacts-info">

        <div class="contact-item">
          <span>{t.organizerLabel}</span>
          <p>{t.organizer}</p>
        </div>

        <div class="contact-item">
          <span>{t.addressLabel}</span>
          <p>{t.address}</p>
        </div>

        <div class="contact-item contact-people">
          <span>{t.contactsLabel}</span>

          <div class="contact-people-list">
            {
              t.coordinators.map((person) => (
                <article class="contact-person">
                  <a href={`tel:${person.phone.replace(/\s/g, "")}`}>
                    {person.phone}
                  </a>

                  <h3>{person.name}</h3>

                  <p>{person.description}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="contact-item">
          <span>{t.emailLabel}</span>
          <a href={`mailto:${t.email}`}>
            {t.email}
          </a>
        </div>

        <div class="contact-item">
          <span>{t.papersLabel}</span>
          <a href={`mailto:${t.papersEmail}`}>
            {t.papersEmail}
          </a>
        </div>

        <div class="contact-item">
          <span>{t.websiteLabel}</span>
          <p>{t.website}</p>
        </div>

      </div>

      <div class="contacts-aside">
        <div class="contacts-mark">
          BFF
          <span>2026</span>
        </div>
      </div>

    </div>

  </div>
</section>