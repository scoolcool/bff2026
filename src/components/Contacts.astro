---
import "../styles/contacts.css";
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].contacts;
---

<section id="contacts" class="section section-light contacts">
  <div class="contacts-grid-bg"></div>

  <div class="container contacts-inner">

    <div class="contacts-heading">
      <div>
        <div class="section-label">
          {t.label}
        </div>

        <h2 class="section-title">
          {t.title}
          <span>{t.titleAccent}</span>
        </h2>
      </div>

      <p class="contacts-intro">
        {t.intro}
      </p>
    </div>

    <div class="contacts-layout">

      <div class="contacts-info">

        <div class="contact-item">
          <span>{t.organizerLabel}</span>
          <p>{t.organizer}</p>
        </div>

        <div class="contact-item">
          <span>{t.addressLabel}</span>
          <p>{t.address}</p>
        </div>

        <div class="contact-item">
          <span>{t.coordinatorLabel}</span>
          <p>{t.coordinator}</p>
        </div>

        <div class="contact-item">
          <span>{t.phoneLabel}</span>
          <a href="tel:+38044">
            {t.phone}
          </a>
        </div>

        <div class="contact-item">
          <span>{t.emailLabel}</span>
          <a href={`mailto:${t.email}`}>
            {t.email}
          </a>
        </div>

        <div class="contact-item">
          <span>{t.papersLabel}</span>
          <a href={`mailto:${t.papersEmail}`}>
            {t.papersEmail}
          </a>
        </div>

        <div class="contact-item">
          <span>{t.websiteLabel}</span>
          <p>{t.website}</p>
        </div>

      </div>

      <div class="contacts-map">
        <div class="contacts-map-label">
          {t.mapTitle}
        </div>

        <iframe
          src="https://www.google.com/maps?q=Київ,вул.%20Сім'ї%20Бродських,6&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={t.mapTitle}
        ></iframe>
      </div>

    </div>

  </div>
</section>