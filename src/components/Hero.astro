---
import "../styles/hero.css";
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].hero;
---

<section class="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>

  <div class="container hero-inner">

    <div class="hero-content">

      <div class="hero-institute">
  {t.institute}
</div>

      <h1 class="hero-title">
        <span>{t.title1}</span>
        <span>{t.title2}</span>
        <span class="hero-title-accent">
          {t.title3} {t.title4}
        </span>
      </h1>

      <p class="hero-subtitle">
        {t.subtitle}
      </p>

      <div class="hero-actions">
        <a
          class="btn btn-primary"
          href="https://docs.google.com/forms/d/e/1FAIpQLSc2ofIiUtdtdjV0MeszjOgk3RupPV5RF0k7XQEZiM9u2S9yGg/viewform?usp=publish-editor"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.register}
        </a>

        <a
          class="btn btn-secondary"
          href="/documents/bff2026-info.pdf"
          target="_blank"
        >
          {t.download}
        </a>
      </div>

    </div>

    <div class="hero-visual">
      <img
        class="hero-coins"
        src="/images/decor/bg_coin.png"
        alt=""
        aria-hidden="true"
      />
    </div>

    <div class="hero-meta">

      <div>
        <span class="meta-label">
          {t.meta.cityLabel}
        </span>

        <strong>
          {t.meta.cityValue}
        </strong>
      </div>

      <div>
        <span class="meta-label">
          {t.meta.formatLabel}
        </span>

        <strong>
          {t.meta.formatValue}
        </strong>
      </div>

      <div>
        <span class="meta-label">
          {t.meta.participationLabel}
        </span>

        <strong>
          {t.meta.participationValue}
        </strong>
      </div>

      <div class="hashtag">
  <img
    src="/images/decor/bff-icon.png"
    alt=""
    aria-hidden="true"
  />

  <span>{t.meta.hashtag}</span>
</div>

    </div>

  </div>
</section>