---
import "../styles/speakers.css";
import { translations, type Language } from "../data/translations";
import { speakers } from "../data/speakers";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].speakers;
---

<section id="speakers" class="section speakers">
  <div class="speakers-grid-bg"></div>

  <div class="container speakers-inner">

    <div class="speakers-heading">
      <div>
        <div class="section-label">
          {t.label}
        </div>

        <h2 class="section-title">
          {t.title}
          <span>{t.titleAccent}</span>
        </h2>
      </div>

      <p class="speakers-intro">
        {t.intro}
      </p>
    </div>

    <div class="speakers-list">
      {
        speakers.map((speaker) => (
          <article class="speaker-card">

            <div class="speaker-photo-wrap">
              <img
  class="speaker-photo"
  src={speaker.photo}
  alt={speaker.name[lang]}
  loading="lazy"
  style={`object-position: ${speaker.imagePosition};`}
/>

              <div class="speaker-panel-badge">
                {speaker.panel[lang]}
              </div>
            </div>

            <div class="speaker-body">

              <div class="speaker-number">
                PANEL {speaker.panelShort}
              </div>

              <h3>
                {speaker.name[lang]}
              </h3>

              {
  speaker.degree[lang] && (
    <p class="speaker-degree">
      {speaker.degree[lang]}
    </p>
  )
}

              <p class="speaker-position">
                {speaker.position[lang]}
              </p>

              <div class="speaker-topic">
                <span>
                  {lang === "uk" ? "Тема виступу" : "Presentation topic"}
                </span>

                <p>
                  {speaker.topic[lang]}
                </p>
              </div>

            </div>

          </article>
        ))
      }
    </div>

    <div class="speakers-bottom">
      <p>
        {t.notice}
      </p>

      <a
        class="speaker-apply"
        href="https://docs.google.com/forms/d/e/1FAIpQLSc2ofIiUtdtdjV0MeszjOgk3RupPV5RF0k7XQEZiM9u2S9yGg/viewform?usp=publish-editor"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.apply}
      </a>
    </div>

  </div>
</section>