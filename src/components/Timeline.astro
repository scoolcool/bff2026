---
import "../styles/timeline.css";
import { translations, type Language } from "../data/translations";

interface Props {
  lang?: Language;
}

const { lang = "uk" } = Astro.props;
const t = translations[lang].timeline;
---

<section id="dates" class="section section-dark timeline">
  <div class="timeline-grid-bg"></div>

  <div class="container timeline-inner">

    <div class="timeline-heading">
      <div>
        <div class="section-label">
          {t.label}
        </div>

        <h2 class="section-title">
          {t.title}
          <span>{t.titleAccent}</span>
        </h2>
      </div>

      <p class="timeline-intro">
        {t.intro}
      </p>
    </div>

    <div class="timeline-list">
      {
        t.items.map((item, index) => (
          <article class="timeline-item">
            <div class="timeline-marker">
              <span class="timeline-dot"></span>
              <span class="timeline-index">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <div class="timeline-date">
              {item.date}
            </div>

            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>