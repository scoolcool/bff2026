---
interface Props {
  lang?: "uk" | "en";
}

const { lang = "uk" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/png"
      href="/images/decor/bff-icon.png"
    />

    <link
      rel="apple-touch-icon"
      href="/images/decor/bff-icon.png"
    />

    <meta
      name="theme-color"
      content="#141414"
    />

    <meta
      name="description"
      content="Blockchain Forensics Forum 2026 — II Міжнародний науково-практичний форум з питань судової експертизи та аналітики цифрових доказів у сфері віртуальних активів і блокчейн-технологій."
    />

    <meta name="generator" content={Astro.generator} />

    <title>Blockchain Forensics Forum 2026</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>